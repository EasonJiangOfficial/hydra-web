# Copy to .env.local (git-ignored). Local values: `supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).

# Supabase project URL (local: http://127.0.0.1:55421). Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Public: shipped to the browser; RLS guards the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...). Server only: admin client and scripts/bootstrap-owner.mts. Never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# The one owner's email. The proxy lets only this account in; bootstrap-owner creates it.
HYDRA_OWNER_EMAIL=
# 1 serves the /dev/* fixture pages in a production build (Playwright sets it). Leave empty in production.
HYDRA_DEV_ROUTES=

# --- Server only below. Never NEXT_PUBLIC. Set in Vercel (Production) too. ---

# Shared secret for Vercel cron (/api/cron/agent, /api/google/cron). Vercel sends it as `Authorization: Bearer`. `openssl rand -hex 32`.
CRON_SECRET=

# Hydra Agent model key (Anthropic Messages API). Unset: /api/agent/turn answers 503 agent_not_configured.
ANTHROPIC_API_KEY=
# Hydra Agent voice (Fish Audio TTS). Unset: the interface speaks with the browser's own voice.
FISH_AUDIO_API_KEY=
# Fish Audio voice id (32 hex characters) from that voice's page on fish.audio.
# Unset: a placeholder id, and Hydra's own voice does not play until you set this.
FISH_DEFAULT_VOICE_ID=

# Google sign-in for Gmail and Calendar (OAuth client, web). Redirect URI: <origin>/api/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Plaid bank feed. PLAID_ENV is sandbox (default) or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
# Encrypts stored Plaid, Google and Instagram tokens (`openssl rand -base64 32`). Losing it means linking every bank again.
HYDRA_TOKEN_KEY=

# Web push to the phone (`npx web-push generate-vapid-keys`). Subject: mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Ripple importer script only (scripts/import-ripple): media host for deal logos. Default https://media.rippleugc.com.
RIPPLE_MEDIA_ORIGIN=

# Connect Instagram for Personal Brand (Instagram API with Unified Login): the Meta app's ID and secret (App
# settings > Basic; not an Instagram app ID) and the Unified login configuration's config_id (in its Login URL).
# Redirect URI: <origin>/api/instagram/callback. Unset: Connect Instagram is off.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_CONFIG_ID=
